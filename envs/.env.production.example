# PRODUCTION: the live database. Copy to envs/.env.production and fill in.
# Never commit the real file: it contains passwords.

# Best practice: use a database user that can only READ (see README, "read-only user").
DATABASE_URL=postgres://READONLY_USER:PASSWORD@prod-db-host:5432/anpr_prod

# Must be the SAME key the production server uses (needed to decrypt bot passwords).
DJANGO_SECRET_KEY=paste-the-production-secret-key-here

# From your laptop, production is read-only: you can look, but not change anything.
# Only set this to false on the production server itself, or for a deliberate fix.
ANPR_READ_ONLY=true
