# Settings for the Docker stack (docker-compose.yaml). Copy to envs/.env.docker and change
# the password. envs/.env.docker is never committed and never copied into the image.

# --- the postgres container (used when it creates the database the first time)
POSTGRES_DB=anpr
POSTGRES_USER=anpr
POSTGRES_PASSWORD=change-me

# --- every app container: the same database, reached by its service name "postgres"
DATABASE_URL=postgres://anpr:change-me@postgres:5432/anpr

# local = this machine (debug pages on, the development secret key is allowed).
# For a real server use production with DJANGO_SECRET_KEY, DJANGO_DEBUG=false and your host names.
ANPR_ENV=local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django-api
# DJANGO_SECRET_KEY=a-long-random-string

# Every bot is one container; add bots by scaling (docker compose up -d --scale bot-ocr=3).
ANPR_BOTS_MANAGED_BY=docker

# Where bots send their flow runs when pipeline.use_prefect is true (start the prefect profile then:
# docker compose --profile prefect up -d). Unused otherwise.
PREFECT_API_URL=http://prefect:4200/api
PREFECT_SERVER_ANALYTICS_ENABLED=false

# Kafka (the kafka service in docker-compose.yaml). Containers reach it by its service name.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# How reader bots find new folders: scan (folders in ./data) or kafka (the anpr.folders topic).
# Overrides reader.mode in config/settings.yaml.
ANPR_READER_MODE=scan
