# STAGING: the test server's database. Copy to envs/.env.staging and fill in.
# Never commit the real file: it contains passwords.

DATABASE_URL=postgres://USER:PASSWORD@staging-db-host:5432/anpr_staging

# Must be the SAME key the staging server uses, or bot passwords stored on staging
# can't be decrypted. Ask whoever runs staging for it.
DJANGO_SECRET_KEY=paste-the-staging-secret-key-here

# Staging is for testing, so changes are allowed by default.
ANPR_READ_ONLY=false
