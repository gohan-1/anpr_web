# Optional: the OCR API account for the bot-ocr containers. Copy to envs/.env.ocr.
# Every bot-ocr container (all replicas) uses this account; the rate limit is per container,
# so 3 replicas with BOT_RATE_LIMIT=2 send up to 6 calls/s in total.
# For bots with DIFFERENT accounts, add one more service per account in docker-compose.yaml.
BOT_API_USERNAME=
BOT_API_PASSWORD=
BOT_RATE_LIMIT=0
# The OCR API itself (instead of api.mock in config/settings.yaml)
# ANPR_API_KEY=
