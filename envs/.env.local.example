# LOCAL: your own machine. Copy to envs/.env.local (optional for local).
# Without DATABASE_URL, local uses main/.env (ANPR_DB_ENGINE / POSTGRES_*) or the SQLite file web/db.sqlite3.

# Your local PostgreSQL (recommended once you run several bots):
# DATABASE_URL=postgres://anpr:anpr_pw@localhost:5432/anpr_local
# Or MySQL (needs: pip install mysqlclient):
# DATABASE_URL=mysql://anpr:anpr_pw@localhost:3306/anpr_local

ANPR_READ_ONLY=false

# Kafka (only when reader bots listen to Kafka). Start Kafka on this machine with: make kafka-up
# Inside Docker the address is kafka:9092 instead (see envs/.env.docker.example).
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# How reader bots find new folders: scan (folders on disk) or kafka (the anpr.folders topic).
# Overrides reader.mode in config/settings.yaml.
# ANPR_READER_MODE=kafka
