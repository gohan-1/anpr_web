# LOCAL: your own machine. Copy to envs/.env.local (optional for local).
# Without DATABASE_URL, local uses the SQLite file web/db.sqlite3.

# Your local PostgreSQL (recommended once you run several bots):
# DATABASE_URL=postgres://anpr:anpr_pw@localhost:5432/anpr_local
# Or MySQL (needs: pip install mysqlclient):
# DATABASE_URL=mysql://anpr:anpr_pw@localhost:3306/anpr_local

ANPR_READ_ONLY=false
